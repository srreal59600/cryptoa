# ---------------------------------------------------------------------------
# WhaleRadar configuration. Copy to .env and fill in your own values.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ---------------------------------------------------------------------------

# --- RPC endpoints (WebSocket + HTTP). Alchemy / QuickNode / Ankr / your node.
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_WS_URL=wss://bsc-rpc.publicnode.com
BSC_HTTP_URL=https://bsc-rpc.publicnode.com
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_HTTP_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_HTTP_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Which chains to run (comma separated chain IDs): 1=ETH 56=BSC 137=Polygon 42161=Arbitrum
ENABLED_CHAINS=1,56,137,42161

# --- Thresholds
MIN_USD=50000              # transfers below this are discarded at ingest
ALERT_USD=100000           # instant alert threshold
FREE_CHANNEL_USD=1000000   # free channel only receives transfers above this
FREE_DELAY_SECONDS=900     # free channel delay (VIP gets it instantly)
SCORER_INTERVAL=5m

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_VIP_CHANNEL_ID=
TELEGRAM_FREE_CHANNEL_ID=
TELEGRAM_ADMIN_IDS=        # comma separated numeric Telegram user IDs
VIP_PRICE_USD=99
VIP_PAYMENT_ADDRESS=

# --- API / dashboard
API_ADDR=:8080
ADMIN_API_KEY=change-me
CORS_ORIGIN=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
