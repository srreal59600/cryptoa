# ---------------------------------------------------------------------------
# WhaleRadar configuration. Copy to .env and fill in your own values.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ---------------------------------------------------------------------------

# --- RPC endpoints (WebSocket + HTTP).
# The publicnode.com endpoints below are free and support eth_subscribe.
# For higher throughput swap in Alchemy / QuickNode keys.
ETH_WS_URL=wss://ethereum-rpc.publicnode.com
ETH_HTTP_URL=https://ethereum-rpc.publicnode.com
BSC_WS_URL=wss://bsc-rpc.publicnode.com
BSC_HTTP_URL=https://bsc-rpc.publicnode.com
POLYGON_WS_URL=wss://polygon-bor-rpc.publicnode.com
POLYGON_HTTP_URL=https://polygon-bor-rpc.publicnode.com
ARBITRUM_WS_URL=wss://arbitrum-one-rpc.publicnode.com
ARBITRUM_HTTP_URL=https://arbitrum-one-rpc.publicnode.com

# Which chains to run (comma separated chain IDs): 1=ETH 56=BSC 137=Polygon 42161=Arbitrum
ENABLED_CHAINS=1,56,137,42161

# --- Thresholds
# Transfers below MIN_USD are discarded at ingest.
MIN_USD=50000
# ALERT_USD is the VIP threshold: >= goes to the VIP channel and VIP DMs.
ALERT_USD=100000
# Free channel band is [FREE_CHANNEL_MIN_USD, ALERT_USD).
FREE_CHANNEL_MIN_USD=50000
# Optional delay (seconds) before posting to the free channel. 0 = instant.
FREE_DELAY_SECONDS=0
# Publish limits per asset class, shaped like the public Whale Alert thresholds
# but ten times smaller so the channels stay usable. "KNOWN" applies when at
# least one side is a labelled wallet (exchange, pool, fund); anonymous
# wallet-to-wallet moves need twice the size.
LIMIT_STABLE_KNOWN_USD=10000000
LIMIT_STABLE_UNKNOWN_USD=20000000
LIMIT_STABLE_MINT_USD=100000000
LIMIT_MAJOR_KNOWN_USD=5000000
LIMIT_MAJOR_UNKNOWN_USD=10000000
LIMIT_TOKEN_KNOWN_USD=2000000
LIMIT_TOKEN_UNKNOWN_USD=5000000
# Channel pacing (Telegram allows ~20 messages/minute per channel).
CHANNEL_INTERVAL_MS=4000
CHANNEL_QUEUE_SIZE=25
SCORER_INTERVAL=5m
# Ham transfer geçmişi bu süreden eskiyse otomatik silinir (0 = kapalı).
DATA_RETENTION=720h

# Wallets moving more than this much USD inside WHALE_ACCOUNT_WINDOW are tracked
# move by move and shown on the whale accounts page.
WHALE_ACCOUNT_MIN_USD=50000000
WHALE_ACCOUNT_WINDOW=720h

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_VIP_CHANNEL_ID=
TELEGRAM_FREE_CHANNEL_ID=
# Comma separated numeric Telegram user IDs.
TELEGRAM_ADMIN_IDS=

# --- VIP subscription (USDT)
VIP_PRICE_USD=9.99
VIP_PLAN_DAYS=30
# tron | bsc | ethereum | polygon | arbitrum
PAYMENT_NETWORK=tron
# USDT receiving address on PAYMENT_NETWORK.
PAYMENT_ADDRESS=
INVOICE_TTL=45m
# Optional, raises TronGrid rate limits when PAYMENT_NETWORK=tron.
TRONGRID_API_KEY=

# --- API / dashboard
API_ADDR=:8080
ADMIN_API_KEY=change-me
CORS_ORIGIN=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Bot username (no @) used by the Telegram login widget.
NEXT_PUBLIC_TELEGRAM_BOT=WhaleRadarWRABot
