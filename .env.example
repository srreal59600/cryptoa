# ---------------------------------------------------------------------------
# WhaleRadar configuration. Copy to .env and fill in your own values.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ---------------------------------------------------------------------------

# --- RPC endpoints (WebSocket + HTTP).
# The publicnode.com endpoints below are free and support eth_subscribe.
# For higher throughput swap in Alchemy / QuickNode keys.
ETH_WS_URL=wss://ethereum-rpc.publicnode.com
ETH_HTTP_URL=https://ethereum-rpc.publicnode.com
BSC_WS_URL=wss://bsc-rpc.publicnode.com
BSC_HTTP_URL=https://bsc-rpc.publicnode.com
POLYGON_WS_URL=wss://polygon-bor-rpc.publicnode.com
POLYGON_HTTP_URL=https://polygon-bor-rpc.publicnode.com
ARBITRUM_WS_URL=wss://arbitrum-one-rpc.publicnode.com
ARBITRUM_HTTP_URL=https://arbitrum-one-rpc.publicnode.com

# Which chains to run (comma separated chain IDs): 1=ETH 56=BSC 137=Polygon 42161=Arbitrum
ENABLED_CHAINS=1,56,137,42161

# --- Thresholds
# Transfers below MIN_USD are discarded at ingest.
MIN_USD=50000
# ALERT_USD is the VIP threshold: >= goes to the VIP channel and VIP DMs.
ALERT_USD=100000
# Free channel band is [FREE_CHANNEL_MIN_USD, ALERT_USD).
FREE_CHANNEL_MIN_USD=50000
# Optional delay (seconds) before posting to the free channel. 0 = instant.
FREE_DELAY_SECONDS=0
# Signal quality: only accumulation flow (exchange outflow / DEX buy) alerts from
# FREE_CHANNEL_MIN_USD up. Distribution flow (exchange deposit / DEX sell) needs SELL_MIN_USD.
SELL_MIN_USD=500000
# Plain wallet-to-wallet / mint / burn transfers: 0 keeps them out of the channels.
UNTAGGED_MIN_USD=0
# Channel pacing (Telegram allows ~20 messages/minute per channel).
CHANNEL_INTERVAL_MS=4000
CHANNEL_QUEUE_SIZE=25
SCORER_INTERVAL=5m

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_VIP_CHANNEL_ID=
TELEGRAM_FREE_CHANNEL_ID=
# Comma separated numeric Telegram user IDs.
TELEGRAM_ADMIN_IDS=
VIP_PRICE_USD=99
VIP_PAYMENT_ADDRESS=

# --- API / dashboard
API_ADDR=:8080
ADMIN_API_KEY=change-me
CORS_ORIGIN=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
